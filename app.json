{
  "expo": {
    "name": "Haystack",
    "slug": "haystack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haystack",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.dahbed55.haystack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0705",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dahbed55.haystack",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0705",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4515907710016956~2931019279",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a29fe15-c41b-4b63-93d6-40da699ddc5b"
      },
      "supabaseUrl": "https://ungcvdmcotjrgzfhzhhc.supabase.co",
      "supabaseAnonKey": "sb_publishable_LKTZSwc2Vn21tN23Zw3fWA_vR44Rr1H",
      "ads": {
        "iosRewardedUnitId": "ca-app-pub-4515907710016956/8871515160",
        "androidRewardedUnitId": ""
      }
    },
    "owner": "dahbed55",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    }
  }
}
